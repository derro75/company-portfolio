this is the center.html
  <!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" text="text/css"href="style.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <script src="include.js" defer></script>
    <script src="https://cdnjs.buymeacoffee.com/1.0.0/button.prod.min.js"></script>
</head>
<body>
    
<main>
  <!-- Home Page -->
  <section id="home-section" class="page-section" style="display:block;">
    <h1>Welcome to Sherrick Web</h1>
    <p>Your trusted web development partner in Kenya.</p>
  </section>

  <!-- Website Design Page -->
  <section id="website-design-service-section" class="page-section" style="display:none;">
    <h1>Website Design Services</h1>
    <p>We build responsive, SEO-friendly, and conversion-optimized websites.</p>
    <ul>
      <li>✅ Custom UI/UX Design</li>
      <li>✅ WordPress & Headless CMS</li>
      <li>✅ E-commerce (WooCommerce, Shopify)</li>
    </ul>
  </section>

  <!-- Add more sections as needed -->
  <section id="mobile-app-development-section" class="page-section" style="display:none;">
    <h1>Mobile App Development</h1>
    <p>Native & cross-platform apps with Flutter and React Native.</p>
  </section>
</main>

</body>
</html>
